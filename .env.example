# Database
DATABASE_URL="postgresql://user:password@localhost:5432/leadrecover"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Test Keys - Replace with Live for Production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_test_key"
STRIPE_SECRET_KEY="sk_test_your_test_key"
STRIPE_WEBHOOK_SECRET="whsec_test_your_webhook_secret"

# Stripe Product IDs
STRIPE_STARTER_PRICE_ID="price_1234567890"
STRIPE_GROWTH_PRICE_ID="price_0987654321"
STRIPE_PRO_PRICE_ID="price_1122334455"

# Email Service (SendGrid, Resend, etc.)
SENDGRID_API_KEY="your-sendgrid-api-key"
# or
RESEND_API_KEY="your-resend-api-key"

# OpenAI (for AI features)
OPENAI_API_KEY="sk-your-openai-key"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
